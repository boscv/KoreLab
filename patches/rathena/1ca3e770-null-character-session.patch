From: KoreLab managed-lab acceptance
Target: rAthena 1ca3e7700939ea40120cb51a777f8681ba5e84ae
File: src/char/char_clif.cpp
Reason: Reject client packets that require an authenticated char session when
        the socket has no char_session_data, rather than dereferencing nullptr.
This patch is scoped to disposable managed builds; it does not change packet
IDs or successful character-selection behavior.

--- a/src/char/char_clif.cpp
+++ b/src/char/char_clif.cpp
@@ -1704,6 +1704,11 @@
 			// login as map-server
 			case 0x2af8: chclif_parse_maplogin(fd); return 0; // avoid processing of followup packets here
 			default:
+				if( sd == nullptr ){
+					ShowError( "chclif_parse: Received packet 0x%x without a character session; disconnecting.\n", cmd );
+					set_eof( fd );
+					return 0;
+				}
 				if( !char_packet_db.handle( fd, *sd ) ){
 					return 0;
 				}
