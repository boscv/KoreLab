+#########################################################################
+# OpenKore - Warp Portal memo configuration and runtime observations
+#########################################################################
+package WarpPortal;
+
+use strict;
+use Exporter 'import';
+use Globals qw(%config %maps_lut $char);
+use Misc ();
+
+our @EXPORT_OK = qw(parseMemoEntry normalizeWarpMap updateServerMemos recordArrival);
+
+sub normalizeWarpMap {
+	my ($map) = @_;
+	return '' unless defined $map;
+	$map =~ s/\.gat\z//i;
+	return '' unless $map =~ /^[a-zA-Z0-9_]+\z/;
+	return '' unless exists $maps_lut{lc($map) . '.rsw'} || exists $maps_lut{$map . '.rsw'};
+	return lc $map;
+}
+
+sub parseMemoEntry {
+	my ($value) = @_;
+	$value = '' unless defined $value;
+	$value =~ s/^\s+|\s+$//g;
+	return { map => '', valid => 1, has_coords => 0 } if $value eq '';
+	return { map => '', valid => 0, has_coords => 0 } unless $value =~ /^([a-zA-Z0-9_]+)(?:\s+(\d+)\s+(\d+))?\z/;
+	my ($raw_map, $x, $y) = ($1, $2, $3);
+	my $map = normalizeWarpMap($raw_map);
+	return { map => '', valid => 0, has_coords => 0 } unless $map;
+	return { map => $map, valid => 1, has_coords => 0 } unless defined $x && defined $y;
+	return { map => '', valid => 0, has_coords => 0 } if $x > 65535 || $y > 65535;
+	return { map => $map, x => 0 + $x, y => 0 + $y, valid => 1, has_coords => 1 };
+}
+
+sub updateServerMemos {
+	my ($args) = @_;
+	return unless $char && $args && ($args->{type} || 0) == 27;
+
+	my @menu = map { normalizeWarpMap($args->{"memo$_"}) || '' } 1 .. 4;
+	$char->{warp} ||= {};
+	$char->{warp}{type} = 27;
+	$char->{warp}{memo} = [grep { $_ ne '' } @menu]; # Preserve the legacy command/list view.
+	$char->{warp}{savepoint} = $menu[0];
+	# Keep the native destination slots intact. AL_WARP selects by menu slot,
+	# so compacting an empty slot would associate later destinations incorrectly.
+	$char->{warp}{memo_slots} = [@menu[1 .. 3]];
+	$char->{warp}{memo_maps_received_at} = time;
+	$char->{warp}{memo_list_provenance} = 'server_warplist';
+
+	my @memos = @{$char->{warp}{memo_slots}};
+	for my $index (1 .. 4) {
+		my $map = $memos[$index - 1] || '';
+		my $key = "memo$index";
+		my $old = parseMemoEntry($config{$key});
+		$char->{warp}{memo_provenance}{$index} = $old->{valid} && $old->{has_coords}
+			? 'configured_or_previously_saved' : ($map ne '' ? 'server_map_only' : 'empty');
+		next unless $config{warpPortal_autoUpdateMemo};
+		my $new = $old->{valid} && $old->{map} eq $map
+			? (defined $config{$key} ? $config{$key} : '')
+			: $map;
+		my $current = defined $config{$key} ? $config{$key} : '';
+		Misc::configModify($key, $new) if $current ne $new;
+	}
+}
+
+sub recordArrival {
+	my ($map, $x, $y, $source, $memo_slot) = @_;
+	return unless $char && defined $x && defined $y;
+	$map = normalizeWarpMap($map);
+	return unless $map;
+	$char->{warp} ||= {};
+	my $slot;
+	if (defined $memo_slot && $memo_slot =~ /^\d+$/ && $memo_slot >= 1 && $memo_slot <= 3) {
+		my $entry = parseMemoEntry($config{"memo$memo_slot"});
+		$slot = $memo_slot if $entry->{valid} && $entry->{map} eq $map;
+	}
+	if (!defined $slot) {
+		my $slots = $char->{warp}{memo_slots} || [];
+		my @matching = grep { ($slots->[$_] || '') eq $map } 0 .. $#$slots;
+		$slot = $matching[0] + 1 if @matching == 1;
+	}
+	$char->{warp}{observed}{$map} = {
+		x => 0 + $x, y => 0 + $y, source => $source || 'confirmed_portal_traversal',
+		current_session => 1,
+		time => time,
+	};
+	$char->{warp}{memo_provenance}{$slot} = 'observed_arrival' if defined $slot;
+	return unless $config{warpPortal_autoUpdateMemo} && defined $slot;
+	my $key = "memo$slot";
+	my $entry = parseMemoEntry($config{$key});
+	return unless $entry->{valid} && $entry->{map} eq $map;
+	# Map-change packet coordinates are the server-confirmed arrival. Replace
+	# stale coordinates when automatic synchronization is enabled; compare
+	# parsed numeric values so equivalent formatting does not cause a write.
+	if (!$entry->{has_coords} || $entry->{x} != $x || $entry->{y} != $y) {
+		my $current = defined $config{$key} ? $config{$key} : '';
+		Misc::configModify($key, "$map $x $y") if $current ne "$map $x $y";
+	}
+	$char->{warp}{memo_provenance}{$slot} = 'observed_arrival_saved';
+}
+
+1;
